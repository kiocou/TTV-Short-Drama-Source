{
  "name": "ttv-short-drama-frontend",
  "private": true,
  "version": "0.0.1",
  "description": "TTV Short Drama — Windows 11 Mica 风格短剧/漫剧桌面播放器前端（React + TypeScript + Vite，配套 Tauri/Rust 后端位于 src-tauri/）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "verify:boost": "node --experimental-strip-types scripts/verify-boost.mjs",
    "verify:tail": "node --experimental-strip-types scripts/verify-playback-tail.mjs",
    "verify:random-pick": "node --experimental-strip-types scripts/verify-random-pick.mjs",
    "verify:launch-overlay": "node --experimental-strip-types scripts/verify-launch-overlay.ts",
    "verify:keyrepeat": "node --experimental-strip-types scripts/verify-keyrepeat.ts",
    "verify:player-toast-dom": "node --experimental-strip-types scripts/verify-player-toast-dom.ts",
    "verify:player-toast": "node --experimental-strip-types scripts/verify-player-toast.ts",
    "verify:player-accessibility": "node --experimental-strip-types scripts/verify-player-accessibility.ts",
    "verify:resume": "node --experimental-strip-types scripts/verify-resume.ts",
    "verify:start": "node --experimental-strip-types scripts/verify-start-position.mjs",
    "verify:attach": "node scripts/verify-attach-retry.mjs",
    "verify:seek": "node --experimental-strip-types scripts/verify-seek-plan.mjs",
    "verify:preferred-player": "node --experimental-strip-types scripts/verify-preferred-player.mjs",
    "verify:playback-routing": "node scripts/verify-playback-routing.mjs",
    "verify:native-address": "node scripts/verify-native-address.mjs",
    "verify:season-label": "node --experimental-strip-types scripts/verify-season-label.mjs",
    "verify:related-section": "node scripts/verify-related-section.mjs",
    "verify:related-pick": "node scripts/verify-related-pick.mjs",
    "verify:history-types": "node --experimental-strip-types scripts/verify-history-types.mjs",
    "verify:kernel-contract": "node --experimental-strip-types scripts/verify-kernel-contract.mjs",
    "verify:recommendation-player": "node --experimental-strip-types scripts/verify-recommendation-player.mjs",
    "verify:related-batch": "node scripts/verify-related-batch.mjs",
    "verify:season-priority": "node scripts/verify-season-priority.mjs",
    "verify:season-api": "node scripts/verify-season-api.mjs",
    "verify:search-season-expand": "node scripts/verify-search-season-expand.mjs",
    "verify:series-grouping": "node scripts/verify-series-grouping.mjs",
    "verify:series-collapse": "node scripts/verify-series-collapse.mjs",
    "verify:season-picker": "node scripts/verify-season-picker.mjs",
    "verify:feed-source": "node --experimental-strip-types scripts/verify-feed-source.mjs",
    "verify:feed-season-e2e": "node scripts/verify-feed-season-e2e.mjs",
    "verify:autoplay-mute": "node --experimental-strip-types scripts/verify-autoplay-mute.mjs",
    "watch:playback": "node scripts/watch-playback.mjs",
    "tauri": "tauri",
    "verify:buffer-rate": "node scripts/verify-buffer-rate.mjs",
    "predev": "node -e \"if(process.platform==='win32'){require('node:child_process').execFileSync('powershell',['-NoProfile','-ExecutionPolicy','Bypass','-File','scripts/ensure-integrity.ps1'],{stdio:'inherit'})}\"",
    "prebuild": "node -e \"if(process.platform==='win32'){require('node:child_process').execFileSync('powershell',['-NoProfile','-ExecutionPolicy','Bypass','-File','scripts/ensure-integrity.ps1'],{stdio:'inherit'})}\"",
    "verify:horizontal-rails": "node scripts/verify-horizontal-rails.mjs",
    "verify:scroll-edges": "node --experimental-strip-types scripts/verify-scroll-edges.mjs",
    "verify:episode-availability": "node --experimental-strip-types scripts/verify-episode-availability.mjs",
    "verify:content-type": "node --experimental-strip-types scripts/verify-content-type.mjs",
    "verify:huangguo": "node --experimental-strip-types scripts/verify-huangguo.mjs",
    "verify:native-player": "node scripts/verify-native-player.mjs",
    "verify:nordic-theme": "node scripts/verify-nordic-theme.mjs",
    "verify:native-theme": "node scripts/verify-native-theme.mjs",
    "verify:native-exit-plan": "node scripts/verify-native-exit-plan.mjs",
    "verify:native-status-contract": "node scripts/verify-native-status-contract.mjs",
    "verify:native-navigate": "node scripts/verify-native-navigate.mjs",
    "verify:feed-view": "node --experimental-strip-types scripts/verify-feed-view.mjs",
    "verify:feed-ai": "node --experimental-strip-types scripts/verify-feed-ai.mjs",
    "verify:seek-coalesce": "node --experimental-strip-types scripts/verify-seek-coalesce.mjs",
    "verify:feed-playback": "node --experimental-strip-types scripts/verify-feed-playback.mjs",
    "verify:feed-series-nav": "node --experimental-strip-types scripts/verify-feed-series-nav.mjs",
    "verify:feed-rank": "node --experimental-strip-types scripts/verify-feed-rank.mjs",
    "verify:feed-cursor": "node --experimental-strip-types scripts/verify-feed-cursor.mjs",
    "verify:feed-prefetch": "node --experimental-strip-types scripts/verify-feed-prefetch.mjs",
    "verify:feed-latency": "node scripts/verify-feed-latency.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
